<Window x:Class="CcCalendar.Desktop.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CcCalendar.Desktop.Views"
        Title="快速新增"
        Width="1180"
        Height="840"
        MinWidth="960"
        MinHeight="700"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        AutomationProperties.Name="快速新增窗口"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="440" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Text="快速新增" />
                <StackPanel Grid.Row="2">
                    <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="类型" />
                    <ComboBox x:Name="KindBox"
                              Height="36"
                              AutomationProperties.Name="新增类型"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding Options}"
                              SelectionChanged="KindSelectionChanged"
                              SelectedItem="{Binding SelectedOption}" />
                    <StackPanel x:Name="MeetingInvitationFields" Margin="0,12,0,0">
                        <TextBlock Margin="0,0,0,4"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="会议邀请"
                                   ToolTip="粘贴或输入腾讯会议邀请内容，点击导入后填充主题、会议号、时间与会议室" />
                        <Grid ToolTip="粘贴或输入腾讯会议邀请内容，点击导入后填充主题、会议号、时间与会议室">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="96" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="MeetingInvitationBox"
                                 Height="96"
                                 AcceptsReturn="True"
                                 AutomationProperties.Name="会议邀请内容"
                                 PreviewKeyDown="MeetingInvitationKeyDown"
                                 Padding="8,6"
                                 TextChanged="MeetingInvitationTextChanged"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="ImportMeetingButton"
                                    Width="72"
                                    Height="34"
                                    AutomationProperties.Name="导入会议邀请"
                                    Click="ImportMeetingClick"
                                    Content="导入"
                                    ToolTip="解析输入框中的腾讯会议邀请并填充字段" />
                            <Button x:Name="PasteMeetingButton"
                                    Width="112"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="粘贴会议邀请"
                                    Click="PasteMeetingClick"
                                    Content="粘贴会议邀请"
                                    ToolTip="读取剪贴板中的腾讯会议邀请内容，仅填入输入框" />
                        </StackPanel>
                        </Grid>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="主题" />
                    <TextBox x:Name="TitleBox"
                             Height="36"
                             AutomationProperties.Name="标题"
                             Padding="10,0"
                             VerticalContentAlignment="Center" />
                    <StackPanel x:Name="EventFields" Margin="0,12,0,0">
                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="会议室" />
                        <ComboBox x:Name="RoomBox"
                                  Height="36"
                                  AutomationProperties.Name="会议室"
                                  ItemsSource="{Binding RoomOptions}"
                                  SelectedItem="{Binding SelectedRoom}"
                                  ToolTip="可选；日程不一定是会议，可不选择会议室" />
                        <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="会议号" />
                        <TextBox x:Name="MeetingNumberBox"
                                 Height="36"
                                 AutomationProperties.Name="会议号"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="腾讯会议号，如 749-5361-1348；保存时会附加到日程标题" />
                        <CheckBox x:Name="AllDayCheckBox"
                                  Margin="0,12,0,0"
                                  AutomationProperties.Name="全天日程"
                                  Checked="AllDayCheckChanged"
                                  Content="全天（不指定时间）"
                                  Unchecked="AllDayCheckChanged" />
                        <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="日期" />
                        <DatePicker x:Name="EventDatePicker"
                                    Height="36"
                                    AutomationProperties.Name="日期"
                                    SelectedDateFormat="Long"
                                    SelectedDate="{Binding SelectedDate}" />
                        <TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="时间" />
                        <Grid x:Name="TimeFields">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="StartTimeBox"
                                      Height="36"
                                      AutomationProperties.Name="开始时间"
                                      DisplayMemberPath="Label"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      MaxDropDownHeight="280"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Label"
                                      ItemsSource="{Binding TimeOptions}"
                                      SelectedItem="{Binding SelectedStartTime}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="至" />
                            <ComboBox x:Name="EndTimeBox"
                                      Grid.Column="2"
                                      Height="36"
                                      AutomationProperties.Name="结束时间"
                                      DisplayMemberPath="Label"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      MaxDropDownHeight="280"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Label"
                                      ItemsSource="{Binding TimeOptions}"
                                      SelectedItem="{Binding SelectedEndTime}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MeetingReminderCheckBox"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="会议提前提醒"
                                      Checked="MeetingReminderCheckChanged"
                                      Content="会议提前提醒"
                                      IsChecked="False"
                                      ToolTip="仅为当前日程设置提醒；取消勾选表示不提醒"
                                      Unchecked="MeetingReminderCheckChanged" />
                            <ComboBox x:Name="MeetingReminderMinutesBox"
                                      Grid.Column="2"
                                      Height="36"
                                      IsEditable="True"
                                      IsEnabled="False"
                                      AutomationProperties.Name="会议提前提醒分钟"
                                      ToolTip="填写会议开始前多少分钟提醒，范围 1 到 1440 分钟">
                                <ComboBoxItem Content="5" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="15" />
                                <ComboBoxItem Content="30" />
                                <ComboBoxItem Content="60" />
                                <ComboBoxItem Content="120" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ToolTip="选择每周重复后，在指定日期范围内为每个勾选的周几各创建一条日程">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="重复" />
                                <ComboBox x:Name="RepeatModeBox"
                                          Grid.Column="2"
                                          Height="36"
                                          AutomationProperties.Name="重复模式"
                                          SelectedIndex="0"
                                          SelectionChanged="RepeatModeChanged">
                                    <ComboBoxItem Content="不重复" />
                                    <ComboBoxItem Content="每周重复" />
                                </ComboBox>
                            </Grid>
                            <StackPanel x:Name="RepeatPanel" Grid.Row="2" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" ToolTip="勾选周几：在下方日期范围内，为每个勾选的日子各创建一条日程">
                                    <CheckBox x:Name="RepeatMonday" AutomationProperties.Name="重复周一" Content="一" />
                                    <CheckBox x:Name="RepeatTuesday" Margin="10,0,0,0" AutomationProperties.Name="重复周二" Content="二" />
                                    <CheckBox x:Name="RepeatWednesday" Margin="10,0,0,0" AutomationProperties.Name="重复周三" Content="三" />
                                    <CheckBox x:Name="RepeatThursday" Margin="10,0,0,0" AutomationProperties.Name="重复周四" Content="四" />
                                    <CheckBox x:Name="RepeatFriday" Margin="10,0,0,0" AutomationProperties.Name="重复周五" Content="五" />
                                    <CheckBox x:Name="RepeatSaturday" Margin="10,0,0,0" AutomationProperties.Name="重复周六" Content="六" />
                                    <CheckBox x:Name="RepeatSunday" Margin="10,0,0,0" AutomationProperties.Name="重复周日" Content="日" />
                                </StackPanel>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="从" />
                                    <DatePicker x:Name="RepeatStartPicker"
                                                Grid.Column="2"
                                                AutomationProperties.Name="重复开始日期"
                                                SelectedDateChanged="RepeatRangeChanged" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="到" />
                                    <DatePicker x:Name="RepeatEndPicker"
                                                Grid.Column="6"
                                                AutomationProperties.Name="重复结束日期"
                                                SelectedDateChanged="RepeatRangeChanged" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="TodoFields" Margin="0,12,0,0" Visibility="Collapsed">
                        <TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" Text="四象限" />
                        <ComboBox x:Name="QuadrantBox"
                                  Height="36"
                                  AutomationProperties.Name="待办四象限"
                                  SelectedIndex="0"
                                  ToolTip="可选；按重要/紧急组合预先归类待办">
                            <ComboBoxItem Content="不指定" />
                            <ComboBoxItem Content="重要且紧急" />
                            <ComboBoxItem Content="重要不紧急" />
                            <ComboBoxItem Content="紧急不重要" />
                            <ComboBoxItem Content="不重要不紧急" />
                        </ComboBox>
                    </StackPanel>
                    <TextBlock x:Name="ValidationText"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource DangerBrush}" />
                </StackPanel>
            </Grid>
            <GridSplitter Grid.Column="1"
                          Width="6"
                          Margin="4,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ToolTip="拖动调整表单与会议室看板的宽度" />
            <views:RoomBookingPicker x:Name="Picker"
                                     Grid.Column="2"
                                     DateSwitched="PickerDateSwitched"
                                     Picked="PickerPicked" />
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="72" AutomationProperties.Name="取消" Click="CancelClick" Content="取消" />
            <Button Width="80"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="创建"
                    Click="CreateClick"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="创建" />
        </StackPanel>
    </Grid>
</Window>
