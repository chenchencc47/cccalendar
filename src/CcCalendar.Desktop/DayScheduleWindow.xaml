<Window x:Class="CcCalendar.Desktop.DayScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="当日日程"
        Width="480"
        Height="400"
        MinWidth="400"
        MinHeight="280"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock x:Name="CountTextBlock"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="{Binding CountText}" />
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding DateText}" />
        </DockPanel>
        <TextBlock Grid.Row="2"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="双击日程可编辑" />
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="54"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Cursor="Hand"
                                MouseLeftButtonDown="EventMouseLeftButtonDown"
                                Tag="{Binding Id}">
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding TimeText}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock VerticalAlignment="Top"
                                               FontSize="14"
                                               Text="{Binding Title}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Location}"
                                               Visibility="{Binding LocationText}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        AutomationProperties.Name="编辑日程"
                                        Click="EditClick"
                                        Tag="{Binding Id}"
                                        ToolTip="编辑日程">
                                    <iconPacks:PackIconLucide Width="15" Height="15" Kind="PencilLine" />
                                </Button>
                                <Button Grid.Column="3"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        AutomationProperties.Name="删除日程"
                                        Click="DeleteClick"
                                        Tag="{Binding Id}"
                                        ToolTip="删除日程">
                                    <iconPacks:PackIconLucide Width="15" Height="15" Kind="Trash2" />
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="72" IsCancel="True" Content="关闭" />
            <Button Width="92"
                    Margin="8,0,0,0"
                    Click="AddClick"
                    Content="新增日程"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
