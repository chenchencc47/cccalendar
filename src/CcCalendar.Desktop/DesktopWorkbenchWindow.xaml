<Window x:Class="CcCalendar.Desktop.DesktopWorkbenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CcCalendar.Desktop.ViewModels"
        Width="1000"
        Height="520"
        MinWidth="420"
        MinHeight="220"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Top="16"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Border x:Name="ChromeBorder"
            Background="{DynamicResource DesktopSurfaceBrush}"
            BorderBrush="{DynamicResource DesktopSeparatorBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid Margin="{DynamicResource DesktopContentPadding}">
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="28" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton Content="月"
                                      IsChecked="{Binding Calendar.Mode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:CalendarViewMode.Month}}"
                                      Style="{StaticResource SegmentToggleStyle}" />
                        <ToggleButton Margin="4,0,8,0"
                                      Content="周"
                                      IsChecked="{Binding Calendar.Mode, Mode=TwoWay, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static vm:CalendarViewMode.Week}}"
                                      Style="{StaticResource SegmentToggleStyle}" />
                        <Button Width="28" Height="28" Padding="0" Command="{Binding Calendar.MovePreviousCommand}" Content="‹" />
                        <Button Width="28" Height="28" Margin="4,0,0,0" Padding="0" Command="{Binding Calendar.MoveNextCommand}" Content="›" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding Calendar.DisplayTitle}" />
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="7" Rows="1">
                    <TextBlock HorizontalAlignment="Center" Text="一" /><TextBlock HorizontalAlignment="Center" Text="二" />
                    <TextBlock HorizontalAlignment="Center" Text="三" /><TextBlock HorizontalAlignment="Center" Text="四" />
                    <TextBlock HorizontalAlignment="Center" Text="五" /><TextBlock HorizontalAlignment="Center" Text="六" />
                    <TextBlock HorizontalAlignment="Center" Text="日" />
                </UniformGrid>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Calendar.VisibleDays}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7">
                                <UniformGrid.Style>
                                    <Style TargetType="UniformGrid">
                                        <Setter Property="Rows" Value="6" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Calendar.Mode, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="{x:Static vm:CalendarViewMode.Week}">
                                                <Setter Property="Rows" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </UniformGrid.Style>
                            </UniformGrid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="DayCell"
                                    Padding="5"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource DesktopSeparatorBrush}"
                                    BorderThickness="0,1,1,0"
                                    MouseLeftButtonDown="DayMouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="17" />
                                        <RowDefinition Height="13" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock x:Name="DateText" Foreground="{DynamicResource DesktopDateTextBrush}" Text="{Binding Date.Day}" />
                                        <TextBlock x:Name="DayBadgeText" Margin="3,0,0,0" FontSize="10" Foreground="{DynamicResource DesktopDateTextBrush}" Text="{Binding DayBadgeText}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SecondaryDateText" Grid.Row="1" HorizontalAlignment="Center" FontSize="10" Foreground="{DynamicResource DesktopLunarTextBrush}" Text="{Binding SecondaryText}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="2" Margin="0,2,0,0" ClipToBounds="True">
                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="16"
                                                            Padding="3,0"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="{DynamicResource DesktopSeparatorBrush}"
                                                            BorderThickness="0"
                                                            Click="EventDetailsClick"
                                                            Tag="{Binding DataContext.Date, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            ToolTip="{Binding Title}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3" />
                                                                <ColumnDefinition Width="34" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{DynamicResource DesktopHolidayTextBrush}" />
                                                            <TextBlock Grid.Column="1" Margin="3,0,0,0" FontSize="9" Foreground="{DynamicResource DesktopSecondaryTextBrush}" Text="{Binding TimeText}" />
                                                            <TextBlock Grid.Column="2" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource DesktopPrimaryTextBrush}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Height="16"
                                                Padding="3,0"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="EventDetailsClick"
                                                Foreground="{DynamicResource DesktopHolidayTextBrush}"
                                                FontSize="9"
                                                Tag="{Binding Date}"
                                                Content="{Binding RemainingEventCount, StringFormat=还有 {0} 项}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding RemainingEventCount}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                    <Setter TargetName="DateText" Property="Foreground" Value="{DynamicResource DesktopWeekendTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                    <Setter TargetName="DayCell" Property="Opacity" Value="{DynamicResource DesktopOtherMonthOpacity}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPublicHoliday}" Value="True">
                                    <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource DesktopDayOffBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAdjustedWorkday}" Value="True">
                                    <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource DesktopWorkdayBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSolarTerm}" Value="True">
                                    <Setter TargetName="SecondaryDateText" Property="Foreground" Value="{DynamicResource DesktopHolidayTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasFestival}" Value="True">
                                    <Setter TargetName="SecondaryDateText" Property="Foreground" Value="{DynamicResource DesktopHolidayTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                    <Setter TargetName="DayCell" Property="Background" Value="{DynamicResource DesktopTodayBackgroundBrush}" />
                                    <Setter TargetName="DateText" Property="Foreground" Value="{DynamicResource DesktopTodayTextBrush}" />
                                    <Setter TargetName="DayBadgeText" Property="Foreground" Value="{DynamicResource DesktopTodayTextBrush}" />
                                    <Setter TargetName="SecondaryDateText" Property="Foreground" Value="{DynamicResource DesktopTodayTextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Grid Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="20" ToolTip="拖动调整宽高">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource DesktopSecondaryTextBrush}" IsHitTestVisible="False" Text="◢" />
                <ResizeGrip AutomationProperties.Name="拖动调整宽高" Background="Transparent" Cursor="SizeNWSE" />
            </Grid>
        </Grid>
    </Border>
</Window>
