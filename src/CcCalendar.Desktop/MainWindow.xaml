<Window x:Class="CcCalendar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CcCalendar.Core;assembly=CcCalendar.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CcCalendar.Desktop.Views"
        Title="{x:Static core:ApplicationIdentity.ProductName}"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <!--
        P70-06b 主导航条目样式：基于主题 NavigationItemStyle（3px 标记条 + AccentSubtle
        选中底 + hover 动画全部继承），仅在 rail 收起态清零条目左右内边距——原 12px×2
        内边距叠加列表 8px×2 内边距后，48px 列里放不下 16px 图标且无法居中。
    -->
    <Window.Resources>
        <Style x:Key="MainNavigationItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource NavigationItemStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Padding" Value="0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    P70-06b 展开态 brand bar：应用图标 + 名称 + 右侧收起按钮
                    （PanelLeft 图标族，与助理会话栏的折叠交互同一视觉语言）。
                -->
                <Grid Margin="20,0,12,0" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <iconPacks:PackIconLucide Width="20"
                                                  Height="20"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource AccentBrush}"
                                                  Kind="CalendarDays" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource FontBrandSize}"
                                   FontWeight="SemiBold"
                                   Text="cccalendar" />
                    </StackPanel>
                    <Button Width="26"
                            Height="26"
                            Padding="0"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="收起导航栏"
                            Command="{Binding ToggleNavCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="收起导航栏">
                        <iconPacks:PackIconLucide Width="15" Height="15" Kind="PanelLeftClose" />
                    </Button>
                </Grid>

                <!-- P70-06b 收起态（rail 48px）：居中的展开按钮，其余空间留给条目图标。 -->
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="展开导航栏"
                        Command="{Binding ToggleNavCommand}"
                        ToolTip="展开导航栏">
                    <iconPacks:PackIconLucide Width="15" Height="15" Kind="PanelLeftOpen" />
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         ItemContainerStyle="{StaticResource MainNavigationItemStyle}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Style="{StaticResource NavigationListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 展开态：图标 + 文字。 -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center"
                                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                            Kind="{Binding Icon}" />
                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                               Text="{Binding Label}" />
                                </Grid>
                                <!--
                                    P70-06b 收起态（rail）：仅居中图标；文字隐藏后整行
                                    ToolTip 补全条目名（当前项标记条来自容器样式，保留）。
                                    Background=Transparent 让整行可命中——Grid 默认背景为
                                    null 时命中区域只剩图标线条，tooltip 大概率不触发。
                                -->
                                <Grid Background="Transparent" ToolTip="{Binding Label}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <iconPacks:PackIconLucide Width="16"
                                                              Height="16"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                              Kind="{Binding Icon}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <!-- Right margin reserves space for window control buttons -->
                <Grid Margin="20,0,140,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        P70-06b 展开态：搜索框 + 旁侧收起小箭头（ChevronUp，最不破坏
                        现有布局）；搜索结果 Popup 一并挂在本容器内，收起时随容器
                        折叠自动关闭，避免残留悬浮结果。
                    -->
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopSearchCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- Search box with overlaid search icon -->
                        <Border x:Name="SearchInputBorder"
                                Width="360"
                                Height="32"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SubtleSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <TextBox x:Name="SearchTextBox"
                                         Margin="32,0,8,0"
                                         Padding="0,4"
                                         VerticalContentAlignment="Center"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索项目、日程、待办和记录" />
                                <iconPacks:PackIconLucide Width="14"
                                                        Height="14"
                                                        Margin="10,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                                        IsHitTestVisible="False"
                                                        Kind="Search" />
                                <TextBlock Margin="32,0,8,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           IsHitTestVisible="False"
                                           Text="搜索项目、日程、待办和记录">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Button Width="26"
                                Height="26"
                                Margin="6,0,0,0"
                                Padding="0"
                                AutomationProperties.Name="收起搜索栏"
                                Command="{Binding ToggleTopSearchCommand}"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="收起搜索栏">
                            <iconPacks:PackIconLucide Width="14" Height="14" Kind="ChevronUp" />
                        </Button>
                        <Popup Width="360"
                               AllowsTransparency="True"
                               IsOpen="{Binding Search.HasResults, Mode=OneWay}"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SearchInputBorder}"
                               StaysOpen="False">
                            <Border Margin="0,4,0,0"
                                    Padding="6"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ListBox MaxHeight="320"
                                         ItemsSource="{Binding Search.Results}"
                                         SelectionChanged="SearchResultSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Text="{Binding Subtitle}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <!-- P70-06b 收起态：搜索栏原位只留搜索图标按钮，点击展开恢复。 -->
                    <Button Width="32"
                            Height="32"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="展开搜索栏"
                            Command="{Binding ToggleTopSearchCommand}"
                            ToolTip="展开搜索栏">
                        <iconPacks:PackIconLucide Width="16" Height="16" Kind="Search" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTopSearchCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsCalendarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Width="32"
                                Height="32"
                                Padding="0"
                                AutomationProperties.Name="导入 ICS 日历"
                                Click="ImportIcsClick"
                                ToolTip="导入 ICS 日历">
                            <iconPacks:PackIconLucide Width="16" Height="16" Kind="FileDown" />
                        </Button>
                        <Button Width="32"
                                Height="32"
                                Margin="6,0,0,0"
                                Padding="0"
                                AutomationProperties.Name="导出 ICS 日历"
                                Click="ExportIcsClick"
                                ToolTip="导出 ICS 日历">
                            <iconPacks:PackIconLucide Width="16" Height="16" Kind="FileUp" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="0"
                                AutomationProperties.Name="下载更新"
                                Click="UpdateClick"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsUpdateAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{Binding UpdateVersion, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=发现新版本 {0}，点击下载并安装}">
                            <!-- Path adapted from the supplied Material Symbols download asset. -->
                            <Path Width="17"
                                  Height="17"
                                  Fill="White"
                                  Stretch="Uniform"
                                  Data="M12,16 L7,11 8.4,9.55 11,12.15 11,4 13,4 13,12.15 15.6,9.55 17,11 Z M6,20 C5.175,20 4.588,19.413 4.588,18.588 L4.588,15 6.588,15 6.588,18 18.588,18 18.588,15 20.588,15 20.588,18.588 C20.588,19.413 20.001,20 19.176,20 Z" />
                        </Button>
                        <Button MinWidth="96"
                                AutomationProperties.Name="快速新增"
                                Click="QuickAddClick"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Width="16" Height="16" Kind="Plus" />
                                <TextBlock Margin="7,0,0,0" Foreground="White" Text="快速新增" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:TodayView DataContext="{Binding Today}"
                                 Visibility="{Binding DataContext.IsTodaySelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:CalendarView x:Name="CalendarPage"
                                    DataContext="{Binding Calendar}"
                                    Visibility="{Binding DataContext.IsCalendarSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ProjectView x:Name="ProjectPage" DataContext="{Binding Projects}"
                                   Visibility="{Binding DataContext.IsProjectsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TodoView x:Name="TodoPage"
                                DataContext="{Binding Todos}"
                                Visibility="{Binding DataContext.IsTodosSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:RecordView x:Name="RecordPage" DataContext="{Binding Records}"
                                  Visibility="{Binding DataContext.IsRecordsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:AssistantView DataContext="{Binding Assistant}"
                                     Visibility="{Binding DataContext.IsAssistantSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ToolsView DataContext="{Binding Tools}"
                                 Visibility="{Binding DataContext.IsToolsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:StatisticsView DataContext="{Binding Statistics}"
                                      Visibility="{Binding DataContext.IsStatisticsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKnownPageSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock HorizontalAlignment="Center"
                               Style="{StaticResource PageTitleStyle}"
                               Text="{Binding SelectedPageTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="该工作区将在后续阶段实现" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
