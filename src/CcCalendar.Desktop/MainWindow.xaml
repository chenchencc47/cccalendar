<Window x:Class="CcCalendar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:CcCalendar.Core;assembly=CcCalendar.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CcCalendar.Desktop.Views"
        Title="{x:Static core:ApplicationIdentity.ProductName}"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Brand bar: app icon + app name -->
                <StackPanel Margin="20,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <iconPacks:PackIconLucide Width="20"
                                              Height="20"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource AccentBrush}"
                                              Kind="CalendarDays" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="cccalendar" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavigationItems}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         Style="{StaticResource NavigationListStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <iconPacks:PackIconLucide Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                                        Kind="{Binding Icon}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           Text="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <!-- Right margin reserves space for window control buttons -->
                <Grid Margin="20,0,140,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search box with overlaid search icon -->
                    <Border x:Name="SearchInputBorder"
                            Height="32"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SubtleSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <TextBox x:Name="SearchTextBox"
                                     Margin="32,0,8,0"
                                     Padding="0,4"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="搜索项目、日程、待办和记录" />
                            <iconPacks:PackIconLucide Width="14"
                                                    Height="14"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                                    IsHitTestVisible="False"
                                                    Kind="Search" />
                            <TextBlock Margin="32,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       IsHitTestVisible="False"
                                       Text="搜索项目、日程、待办和记录">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchTextBox}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <Popup Grid.Column="0"
                           Width="360"
                           AllowsTransparency="True"
                           IsOpen="{Binding Search.HasResults, Mode=OneWay}"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=SearchInputBorder}"
                           StaysOpen="False">
                        <Border Margin="0,4,0,0"
                                Padding="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ListBox MaxHeight="320"
                                     ItemsSource="{Binding Search.Results}"
                                     SelectionChanged="SearchResultSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Subtitle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                    <StackPanel Grid.Column="1"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Visibility="{Binding IsCalendarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Width="32"
                                Height="32"
                                Padding="0"
                                AutomationProperties.Name="导入 ICS 日历"
                                Click="ImportIcsClick"
                                ToolTip="导入 ICS 日历">
                            <iconPacks:PackIconLucide Width="16" Height="16" Kind="FileDown" />
                        </Button>
                        <Button Width="32"
                                Height="32"
                                Margin="6,0,0,0"
                                Padding="0"
                                AutomationProperties.Name="导出 ICS 日历"
                                Click="ExportIcsClick"
                                ToolTip="导出 ICS 日历">
                            <iconPacks:PackIconLucide Width="16" Height="16" Kind="FileUp" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Width="34"
                                Height="34"
                                Margin="0,0,8,0"
                                Padding="0"
                                AutomationProperties.Name="下载更新"
                                Click="UpdateClick"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding IsUpdateAvailable, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{Binding UpdateVersion, RelativeSource={RelativeSource AncestorType=Window}, StringFormat=发现新版本 {0}，点击下载并安装}">
                            <!-- Path adapted from the supplied Material Symbols download asset. -->
                            <Path Width="17"
                                  Height="17"
                                  Fill="White"
                                  Stretch="Uniform"
                                  Data="M12,16 L7,11 8.4,9.55 11,12.15 11,4 13,4 13,12.15 15.6,9.55 17,11 Z M6,20 C5.175,20 4.588,19.413 4.588,18.588 L4.588,15 6.588,15 6.588,18 18.588,18 18.588,15 20.588,15 20.588,18.588 C20.588,19.413 20.001,20 19.176,20 Z" />
                        </Button>
                        <Button MinWidth="96"
                                AutomationProperties.Name="快速新增"
                                Click="QuickAddClick"
                                Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Width="16" Height="16" Kind="Plus" />
                                <TextBlock Margin="7,0,0,0" Foreground="White" Text="快速新增" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:TodayView DataContext="{Binding Today}"
                                 Visibility="{Binding DataContext.IsTodaySelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:CalendarView x:Name="CalendarPage"
                                    DataContext="{Binding Calendar}"
                                    Visibility="{Binding DataContext.IsCalendarSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ProjectView x:Name="ProjectPage" DataContext="{Binding Projects}"
                                   Visibility="{Binding DataContext.IsProjectsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TodoView x:Name="TodoPage"
                                DataContext="{Binding Todos}"
                                Visibility="{Binding DataContext.IsTodosSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:RecordView x:Name="RecordPage" DataContext="{Binding Records}"
                                  Visibility="{Binding DataContext.IsRecordsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:AssistantView DataContext="{Binding Assistant}"
                                     Visibility="{Binding DataContext.IsAssistantSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:ToolsView DataContext="{Binding Tools}"
                                 Visibility="{Binding DataContext.IsToolsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:StatisticsView DataContext="{Binding Statistics}"
                                      Visibility="{Binding DataContext.IsStatisticsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKnownPageSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding SelectedPageTitle}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="该工作区将在后续阶段实现" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
