<Window x:Class="CcCalendar.Desktop.ReminderPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Width="380"
        Height="190"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="18,16">
            <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <iconPacks:PackIconLucide Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Kind="Bell" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding Header}" />
                <Button Grid.Column="2" Width="28" Height="28" Padding="0" Click="AcknowledgeClick" ToolTip="关闭提醒">
                    <iconPacks:PackIconLucide Width="15" Height="15" Kind="X" />
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Delivery.Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding TriggerText}" />
                <TextBlock x:Name="ErrorText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <ComboBox Width="112" DisplayMemberPath="Label" ItemsSource="{Binding SnoozeOptions}" SelectedItem="{Binding SelectedSnoozeOption}" />
                <Button Width="96" Margin="8,0,0,0" Click="SnoozeClick" Content="稍后提醒" />
                <Button Width="72" Margin="8,0,0,0" Click="AcknowledgeClick" Style="{StaticResource PrimaryButtonStyle}" Content="完成" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
