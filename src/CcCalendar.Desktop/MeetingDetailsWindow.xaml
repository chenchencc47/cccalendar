<Window x:Class="CcCalendar.Desktop.MeetingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会议详情"
        Width="620"
        Height="520"
        MinWidth="480"
        MinHeight="320"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MetaText" Grid.Row="1" Margin="0,8,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBox x:Name="InvitationText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AddToCalendarButton" Width="150" Click="AddToCalendarClick" Content="添加到我的日程" Visibility="Collapsed" />
            <Button x:Name="DeleteBookingButton" Width="130" Margin="8,0,0,0" Click="DeleteBookingClick" Content="删除我的预约" Visibility="Collapsed" />
            <Button Width="140" Click="CopyAllClick" Content="复制全部信息" />
            <Button Width="160" Margin="8,0,0,0" Click="CopyLinkClick" Content="复制会议号和链接" />
            <Button Width="72" Margin="8,0,0,0" IsCancel="True" Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
