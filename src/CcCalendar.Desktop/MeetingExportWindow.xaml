<Window x:Class="CcCalendar.Desktop.MeetingExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出当天会议"
        Width="760"
        Height="620"
        MinWidth="560"
        MinHeight="360"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Width="120" AutomationProperties.Name="复制全部会议" Click="CopyAllClick" Content="复制全部会议" />
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="当天会议邀请" />
        </DockPanel>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MeetingItems" />
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="72" IsCancel="True" Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
