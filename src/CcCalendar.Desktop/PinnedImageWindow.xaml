<Window x:Class="CcCalendar.Desktop.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="360"
        MinWidth="160"
        MinHeight="120"
        Background="Black"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        MouseLeftButtonDown="WindowMouseLeftButtonDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="PinnedZoomTransform" ScaleX="1" ScaleY="1" />
                </Border.LayoutTransform>
                <Image x:Name="PinnedImage" Stretch="Fill" />
            </Border>
        </ScrollViewer>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Width="28" Height="26" Padding="0" Click="ZoomOutClick" Content="−" ToolTip="缩小" />
            <TextBlock x:Name="ZoomText"
                       Width="48"
                       Foreground="White"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       Text="100%" />
            <Button Width="28" Height="26" Padding="0" Click="ZoomInClick" Content="+" ToolTip="放大" />
        </StackPanel>
        <Button Width="28"
                Height="28"
                Margin="8"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Click="CloseClick"
                Content="×"
                ToolTip="关闭" />
    </Grid>
</Window>
