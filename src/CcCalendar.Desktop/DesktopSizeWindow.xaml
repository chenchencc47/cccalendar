<Window x:Class="CcCalendar.Desktop.DesktopSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置宽高"
        Width="360"
        Height="230"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="36" />
            <RowDefinition Height="10" />
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="设置组件宽高" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="宽度" />
            <TextBox x:Name="WidthBox" Grid.Column="1" Padding="8,0" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="px" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="高度" />
            <TextBox x:Name="HeightBox" Grid.Column="1" Padding="8,0" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="px" />
        </Grid>
        <TextBlock x:Name="ValidationText" Grid.Row="5" Margin="72,8,0,0" Foreground="{DynamicResource DangerBrush}" />
        <StackPanel Grid.Row="6" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Width="72" IsCancel="True" Content="取消" />
            <Button Width="80" Margin="8,0,0,0" Click="ApplyClick" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Content="应用" />
        </StackPanel>
    </Grid>
</Window>
