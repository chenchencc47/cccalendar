<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- cccalendar Dark Theme Tokens
         Per UI_DESIGN.md section 2.3 dark theme spec.
         Same resource keys as Theme.xaml light brushes so DynamicResource
         references resolve correctly when this dictionary is merged. -->

    <!-- Color: Page Surfaces -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#181A1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#22252A" />
    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#1E2024" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#2A2E34" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2D3138" />
    <SolidColorBrush x:Key="PressedBrush" Color="#33373F" />

    <!-- Color: Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F2F4" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A8AFB8" />

    <!-- Color: Border -->
    <SolidColorBrush x:Key="BorderBrush" Color="#383D45" />

    <!-- Color: Accent (Primary) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#5794E6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA3EB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4A82CC" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1C2A38" />

    <!-- Color: Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#4EAF7A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D89342" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E25563" />

    <!--
        Color: 语义画刷覆写（P60-01）。
        间距/圆角/字号/控件尺寸/动效是跨主题常量，只在 Theme.xaml 声明一次，此处不覆写。
    -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#383D45" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#4A5058" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#5794E6" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="ElevationPanelBrush" Color="#22252A" />
    <SolidColorBrush x:Key="ElevationProminentBrush" Color="#2A2E34" />

    <!--
        Color: 会议室看板语义色覆写（P60-03）。
        深色下看板底色跟随主表面，状态色改为低亮度底 + 高亮度字，保证 4.5:1 以上对比度。
    -->
    <SolidColorBrush x:Key="RoomBoardGridSurfaceBrush" Color="#22252A" />
    <SolidColorBrush x:Key="RoomBoardGridHourBrush" Color="#383D45" />
    <SolidColorBrush x:Key="RoomBoardGridHalfHourBrush" Color="#2C3038" />
    <SolidColorBrush x:Key="RoomBoardOccupiedFillBrush" Color="#2F333A" />
    <SolidColorBrush x:Key="RoomBoardOccupiedTextBrush" Color="#A8AFB8" />
    <SolidColorBrush x:Key="RoomBoardOwnedFillBrush" Color="#1C2A38" />
    <SolidColorBrush x:Key="RoomBoardOwnedTextBrush" Color="#8FB8F0" />
    <SolidColorBrush x:Key="RoomBoardSelectedFreeFillBrush" Color="#1C3A2A" />
    <SolidColorBrush x:Key="RoomBoardSelectedFreeTextBrush" Color="#7FCFA2" />
    <SolidColorBrush x:Key="RoomBoardConflictFillBrush" Color="#3A2026" />
    <SolidColorBrush x:Key="RoomBoardConflictTextBrush" Color="#F09AA5" />
    <SolidColorBrush x:Key="RoomBoardHandleFillBrush" Color="#22252A" />
    <SolidColorBrush x:Key="RoomBoardPreviewFillBrush" Color="#335794E6" />
</ResourceDictionary>
