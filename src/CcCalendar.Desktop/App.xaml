<Application x:Class="CcCalendar.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CcCalendar.Desktop.Converters"
             xmlns:local="clr-namespace:CcCalendar.Desktop"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <converters:EnumEqualsConverter x:Key="EnumEqualsConverter" />
            <converters:ColorStringToBrushConverter x:Key="ColorStringToBrushConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
