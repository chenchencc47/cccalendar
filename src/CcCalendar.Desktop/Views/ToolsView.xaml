<UserControl x:Class="CcCalendar.Desktop.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="今日专注" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayFocusMinutes}" />
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="分钟" />
                <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="番茄" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayPomodoroCount}" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="工具中心" />
        </DockPanel>

        <TabControl Grid.Row="2">
            <TabItem Header="时间工具">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="时间进度" />
                        <TextBlock Margin="0,18,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="今天" />
                        <ProgressBar Maximum="100" Value="{Binding Progress.DayPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="本周" />
                        <ProgressBar Maximum="100" Value="{Binding Progress.WeekPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="本月" />
                        <ProgressBar Maximum="100" Value="{Binding Progress.MonthPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,14,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="今年" />
                        <ProgressBar Maximum="100" Value="{Binding Progress.YearPercent, Mode=OneWay}" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                    <StackPanel Grid.Column="2" Margin="24,0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="日期计算" />
                        <TextBlock Margin="0,18,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="开始日期" />
                        <DatePicker SelectedDate="{Binding DateStart}" />
                        <TextBlock Margin="0,12,0,5" Foreground="{DynamicResource TextSecondaryBrush}" Text="结束日期" />
                        <DatePicker SelectedDate="{Binding DateEnd}" />
                        <TextBlock Margin="0,14,0,0" Text="{Binding DaysBetween, StringFormat=相差 {0} 天}" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                            <TextBox Width="64" Text="{Binding DateOffsetDays, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="天后" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="{Binding AddedDate, StringFormat={}{0:yyyy-MM-dd}}" />
                    </StackPanel>
                    <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" />
                    <StackPanel Grid.Column="4" Margin="24,0,0,0">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="世界时钟" />
                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding WorldClocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding City}" />
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding LocalTime, StringFormat={}{0:HH:mm:ss}}" />
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource CaptionTextStyle}" Text="{Binding LocalTime, StringFormat={}{0:M月d日}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="专注">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="倒计时" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="时长" />
                                <TextBox Width="72"
                                         Margin="8,0,0,0"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding CountdownMinutes, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="输入 1 到 1440 分钟" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="分钟" />
                            </StackPanel>
                            <TextBlock Margin="0,18,0,0" FontSize="44" FontWeight="SemiBold" Text="{Binding CountdownText}" />
                            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding CountdownStatus}" />
                            <StackPanel Margin="0,22,0,0" Orientation="Horizontal">
                                <Button MinWidth="88" Command="{Binding ToggleCountdownCommand}" Content="{Binding CountdownActionText}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button MinWidth="88" Margin="8,0,0,0" Command="{Binding ResetCountdownCommand}" Content="重置" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
                        <StackPanel Grid.Column="2" Margin="28,0,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="番茄钟" />
                                <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" Text="{Binding PomodoroPhaseText}" />
                            </DockPanel>
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="专注" />
                                <TextBox Width="56"
                                         Margin="8,0,0,0"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding PomodoroFocusMinutes, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="专注时长（分钟）" />
                                <TextBlock Margin="6,0,12,0" VerticalAlignment="Center" Text="分钟" />
                                <TextBlock VerticalAlignment="Center" Text="休息" />
                                <TextBox Width="56"
                                         Margin="8,0,0,0"
                                         HorizontalContentAlignment="Center"
                                         Text="{Binding PomodoroBreakMinutes, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="休息时长（分钟）" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="分钟" />
                            </StackPanel>
                            <TextBlock Margin="0,18,0,0" FontSize="44" FontWeight="SemiBold" Text="{Binding PomodoroText}" />
                            <StackPanel Margin="0,44,0,0" Orientation="Horizontal">
                                <Button MinWidth="88" Command="{Binding TogglePomodoroCommand}" Content="{Binding PomodoroActionText}" Style="{StaticResource PrimaryButtonStyle}" />
                                <Button MinWidth="88" Margin="8,0,0,0" Command="{Binding ResetPomodoroCommand}" Content="重置" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Padding="0,18,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="健康提醒" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding HourlyChimeEnabled}" Content="整点报时" />
                                <CheckBox Margin="28,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SedentaryReminderEnabled}" Content="久坐提醒" />
                                <TextBox Width="56" Margin="10,0,0,0" Text="{Binding SedentaryIntervalMinutes, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="分钟" />
                                <Button Margin="18,0,0,0" Command="{Binding RecordActivityCommand}" Content="已起身，重新计时" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="截图与贴屏">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="截图与标注" />
                    <WrapPanel Margin="0,14,0,0">
                        <Button MinWidth="104" Click="CaptureRegionClick" Content="区域截图" Style="{StaticResource PrimaryButtonStyle}" />
                        <Button MinWidth="104" Margin="8,0,0,0" Click="CaptureWindowClick" Content="窗口截图" />
                        <Button MinWidth="104" Margin="8,0,0,0" Click="CaptureFullScreenClick" Content="全屏截图" />
                        <Button MinWidth="104" Margin="8,0,0,0" Click="CaptureLongClick" Content="长截图" />
                        <Button MinWidth="104" Margin="8,0,0,0" Click="PinImageClick" Content="图片贴屏" />
                    </WrapPanel>
                    <Border Margin="0,24,0,0" Padding="0,20,0,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <StackPanel DataContext="{Binding WindowPin}">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="窗口置顶" />
                            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                <ComboBox Width="360" DisplayMemberPath="Title" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" ToolTip="选择要置顶的窗口" />
                                <Button Margin="8,0,0,0" Command="{Binding RefreshCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="刷新窗口列表">
                                    <iconPacks:PackIconLucide Width="15" Height="15" Kind="RefreshCw" />
                                </Button>
                                <Button MinWidth="88" Margin="8,0,0,0" Command="{Binding ToggleCommand}" Content="{Binding ToggleActionText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="剪贴板">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Width="300" KeyDown="ClipboardSearchKeyDown" Text="{Binding ClipboardSearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索剪贴板历史" />
                            <Button Margin="6,0,0,0" AutomationProperties.Name="搜索剪贴板历史" Click="SearchClipboardClick" Style="{StaticResource IconButtonStyle}" ToolTip="搜索"><iconPacks:PackIconLucide Width="15" Height="15" Kind="Search" /></Button>
                            <Button Margin="6,0,0,0" AutomationProperties.Name="收藏或取消收藏" Click="ToggleClipboardFavoriteClick" Style="{StaticResource IconButtonStyle}" ToolTip="收藏或取消收藏"><iconPacks:PackIconLucide Width="15" Height="15" Kind="Star" /></Button>
                            <Button Margin="6,0,0,0" AutomationProperties.Name="复制选中历史" Click="RestoreClipboardClick" Style="{StaticResource IconButtonStyle}" ToolTip="复制选中内容"><iconPacks:PackIconLucide Width="15" Height="15" Kind="Copy" /></Button>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleStyle}" Text="剪贴板历史" />
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ClipboardEntries}" SelectedItem="{Binding SelectedClipboardEntry, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                                    <iconPacks:PackIconLucide x:Name="KindIcon" Width="16" Height="16" VerticalAlignment="Center" Kind="Clipboard" />
                                    <TextBlock Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                                    <iconPacks:PackIconLucide Grid.Column="2" Width="14" Height="14" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Kind="Star" Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="{Binding CreatedAtUtc, StringFormat={}{0:MM-dd HH:mm}}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Image"><Setter TargetName="KindIcon" Property="Kind" Value="Image" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="Files"><Setter TargetName="KindIcon" Property="Kind" Value="Files" /></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
