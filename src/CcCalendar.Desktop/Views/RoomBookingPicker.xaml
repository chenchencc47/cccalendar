<UserControl x:Class="CcCalendar.Desktop.Views.RoomBookingPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CcCalendar.Desktop.Views"
             AutomationProperties.Name="会议室时间视图区">
    <Grid>
        <Grid.RowDefinitions>
            <!--
                第 0 行固定 32（紧凑档）、第 2 行固定 26（表头）。看板顶边 = 32 + 8 + 26 = 66，
                这一几何被 RoomBookingPickerRuntimeTests 当作契约断言。显式钉住行高，
                避免全局 UiControlHeight 调整（P61-06b 由 32 抬到 36）把看板整体推下去。
            -->
            <RowDefinition Height="32" />
            <RowDefinition Height="8" />
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="44" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
            <!--
                日期导航行（P61-06b）：按紧凑档固定高度 32。
                这一行的高度直接决定看板顶边的 y 坐标，而 RoomBookingPickerRuntimeTests
                把「板顶边 = 顶部按钮行(32) + 8 间隙 + 表头行(26) = 66」当作契约断言。
                全局把 UiControlHeight 抬到 36 后此处会长高 4px、把看板整体下移，
                因此显式钉住紧凑档，保持看板几何不被全局留白调整牵连。
            -->
            <RepeatButton x:Name="PreviousButton"
                          Grid.Column="1"
                          Width="32"
                          Height="{DynamicResource UiCompactControlHeight}"
                          Margin="8,0,0,0"
                          AutomationProperties.Name="前一天"
                          Click="PreviousClick"
                          Content="‹" />
            <RepeatButton x:Name="NextButton"
                          Grid.Column="2"
                          Width="32"
                          Height="{DynamicResource UiCompactControlHeight}"
                          Margin="4,0,0,0"
                          AutomationProperties.Name="后一天"
                          Click="NextClick"
                          Content="›" />
            <TextBlock x:Name="DateText"
                       Grid.Column="3"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14" />
            <Button x:Name="ExportButton"
                    Grid.Column="4"
                    MinWidth="84"
                    Height="{DynamicResource UiCompactControlHeight}"
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="导出当天会议"
                    Click="ExportClick"
                    Content="导出当天会议"
                    ToolTip="查看并复制当天已导入的会议邀请" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="HeaderScroll"
                          Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RoomHeader"
                              ItemsSource="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{x:Static views:RoomBookingBoardControl.RoomWidth}"
                                    Padding="4,4"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,1,1">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <ScrollViewer x:Name="BodyScroll"
                      Grid.Row="3"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="BodyScrollChanged">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="HourLabels">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="44" Height="{x:Static views:RoomBookingBoardControl.HourHeight}">
                                <TextBlock Margin="0,-2,8,0"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <views:RoomBookingBoardControl x:Name="Board"
                                               Grid.Column="1"
                                               VerticalAlignment="Top"
                                               ToolTipService.InitialShowDelay="200"
                                               ToolTipService.ShowDuration="15000"
                                               SelectionChanged="BoardSelectionChanged" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
