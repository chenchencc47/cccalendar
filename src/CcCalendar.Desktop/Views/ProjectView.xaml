<UserControl x:Class="CcCalendar.Desktop.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitleStyle}" Text="项目" />
            <Button DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Click="CreateProjectClick"
                    Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Width="16" Height="16" Kind="Plus" />
                    <TextBlock Margin="7,0,0,0" Foreground="White" Text="新增项目" />
                </StackPanel>
            </Button>
        </DockPanel>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProjects}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <iconPacks:PackIconLucide Width="28"
                                            Height="28"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Kind="FolderKanban" />
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="还没有项目" />
            <Button Margin="0,16,0,0"
                    Click="CreateProjectClick"
                    Content="创建第一个项目"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProjects}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox Margin="0,0,20,0"
                     DisplayMemberPath="Name"
                     ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}" />
            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />
            <TabControl Grid.Column="2" Margin="20,0,0,0">
                <TabItem Header="概览">
                    <StackPanel Margin="16">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedProject.Name}" />
                        <Button Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="DeleteProjectClick"
                                Content="删除项目"
                                ToolTip="将当前项目移入回收站" />
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" Text="项目完成率" />
                        <ProgressBar Height="8" Margin="0,8,0,0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                        <WrapPanel Margin="0,16,0,0">
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="待办总数" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding TotalCount}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="已完成" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding CompletedCount}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="4"
                                    Padding="8"
                                    Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Text="进行中" />
                                    <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding ActiveCount}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>
                <TabItem Header="看板">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="12" ItemsSource="{Binding KanbanColumns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190"
                                            Margin="0,0,12,0"
                                            Padding="12"
                                            Background="Transparent"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        Background="{DynamicResource SubtleSurfaceBrush}"
                                                        CornerRadius="4"
                                                        Padding="6,2">
                                                    <TextBlock FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="{Binding Items.Count, StringFormat={}{0} 项}" />
                                                </Border>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                            </DockPanel>
                                            <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6"
                                                                Padding="10,8"
                                                                Background="{DynamicResource SurfaceBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="8"
                                                                        Height="8"
                                                                        Margin="0,0,8,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="{DynamicResource AccentBrush}"
                                                                        CornerRadius="4" />
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="里程碑">
                    <ListBox Margin="16" ItemsSource="{Binding Milestones}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                    <TextBlock Text="{Binding Title}" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="甘特图">
                    <ScrollViewer Margin="16" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl MinWidth="720"
                                      ItemsSource="{Binding GanttRows}"
                                      AlternationCount="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="42">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                        <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                                        <Border Grid.Column="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1,0,0,0">
                                            <Canvas Background="{DynamicResource SubtleSurfaceBrush}">
                                                <Border Height="18"
                                                        Canvas.Left="{Binding BarOffset}"
                                                        Canvas.Top="12"
                                                        Width="{Binding BarWidth}"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="4"
                                                        ToolTip="{Binding StartDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                            </Canvas>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
